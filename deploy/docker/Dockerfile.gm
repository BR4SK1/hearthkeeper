# GM orchestration service image. Built from the repo ROOT (workspace):
#   docker build -f deploy/docker/Dockerfile.gm -t hearthkeeper/gm:latest .
# No multistage — node:22-alpine with pnpm via corepack; the fillers dir
# (services/gm/assets/fillers/*.wav) is copied in and loaded at boot.
FROM node:22-alpine

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages ./packages
COPY services ./services

# pnpm v10 blocks dependency build scripts in non-interactive CI
# (ERR_PNPM_IGNORED_BUILDS on esbuild's postinstall). All native binaries this
# workspace needs (esbuild, @next/swc, sharp) ship as platform optional-deps,
# so install with --ignore-scripts; package builds below are plain tsc/next.
RUN corepack pnpm install --frozen-lockfile --ignore-scripts
RUN corepack pnpm --filter @hearthkeeper/libs build && corepack pnpm --filter @hearthkeeper/service-gm build

EXPOSE 3001

CMD ["node", "services/gm/dist/index.js"]
