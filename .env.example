# Copy to .env and set the values required by your local services.

# Service ports
HOST=0.0.0.0
MEMORY_PORT=3002
GM_PORT=3001

# MongoDB (memory service)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=hearthkeeper
MONGO_ENSURE_INDEXES=false

# OpenRouter (GM service)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GM_PREMISE=A rain-slicked megacity where the neon never sleeps and the debt collectors always do — eventually. You are small-time operators and fixers in its lower districts, carrying one bad debt to a fixer who does not forgive and chasing one big score that could clear it. Every favor costs, every contact lies, and the only way out is through.
FILLER_ASSETS_DIR=

GM_MAX_TOKENS=700
GM_LLM_TIMEOUT_MS=90000
GM_TTS_TIMEOUT_MS=90000
GM_TURN_LENGTH=adaptive

# Chatterbox-compatible TTS service
CHATTERBOX_BASE_URL=http://localhost:8000
CHATTERBOX_VOICE_MODE=clone
CHATTERBOX_REFERENCE_AUDIO=reference.wav
GM_TTS_STREAM=true
GM_TTS_CHUNK_SIZE=100

# Client-to-GM URL. Set empty to use a same-origin reverse proxy.
NEXT_PUBLIC_GM_BASE_URL=http://localhost:3001
